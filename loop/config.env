# loop/config.env
# アナログメーター「目盛り推定」精度改善ループの設定。
# 2026-08-29、対象を目盛り(スケール)推定アルゴリズムに絞り込み、目視確認ステップを追加した
# (詳細: Obsidian [[project-sotuken-accuracy-loop]])。旧設定(2026-08-25、パイプライン全体・
# scope=all基準)は下記THRESHOLDの単位が古いbaselineに合わなくなったため置き換えた。

# --- 対象スコープ ---
# round(丸型計器)に限定する。square/fan/dark_roundは別担当(T5等)で本ループの対象外。
# 2026-08-29、20260817_134647.jpgのみ画像の向きがおかしいと本人が目視確認で判明したため、
# scope を round_orientation_pending に退避しround scopeから除外した(groundtruth.json参照)。
# round は 9枚→8枚になった。
#
# 2026-09-01追記: 上の除外はコミット 6aeb80d(T3-1 向き補正の結線)で解消済みで、
# 現在の groundtruth.json の round は9枚に戻っている。したがって EVAL_SCOPE=round は
# いま走らせると8枚ではなく9枚を評価する。
# **下の THRESHOLD_MEAN_REF_ERROR は8枚時点のベースラインに対して決めた値なので、
# このループを再開する場合は9枚で測り直してから閾値を設定し直すこと。**
# 精度改善は2026-09-01に凍結したため、値は当時のまま残してある(意図的に更新していない)。
EVAL_SCOPE=round

# --- 終了条件 (evaluator-optimizer: 検証者=evaluate.py, 生成者=Codex) ---
# ベースライン: 2026-08-29実測(134647除外後)、--scope round --no-vlm、8枚。
#   平均引用誤差1.45%FS 中央値1.04%FS 許容内7/8 破滅的失敗0
#   目盛りレンジの誤検出1件(気密試験_昇圧後圧力計: 検出0-108 / 正解0-150)
# 目標: この1件を直しつつ他を退行させない。目安として平均を1.0%FS未満まで下げる。
THRESHOLD_MEAN_REF_ERROR=1.0

# --- 反復回数の上限 (ハード上限。コード側for文で強制) ---
MAX_ITERS=5

# --- 予算上限 (形式的チェックのみ。Codexの実行自体はChatGPT Plus月額内でAPI従量課金なし。
#     反復回数(MAX_ITERS)が実質的な上限として機能する) ---
BUDGET_ITERS=5

# --- サンドボックス ---
REPO_MAIN="C:/卒研/git_stk/sotuken"
WORKTREE_DIR="C:/卒研/git_stk/sotuken-loop"
LOOP_BRANCH="loop/meter-accuracy"

# --- 評価コマンド ---
# venv は worktree にはコピーしない(gitignore対象)。main側のvenvをインタプリタとして
# 絶対パスで使い、cwdだけworktreeに向ける(コードはworktree内のものが実行される)。
PYTHON_EXE="$REPO_MAIN/venv/Scripts/python.exe"
EVAL_SCRIPT="evaluate.py"
GROUNDTRUTH="eval/groundtruth.json"

# --- Codex (生成者) ---
CODEX_EXE="/c/Users/dorum/AppData/Local/Programs/OpenAI/Codex/bin/codex"
CODEX_MODEL="gpt-5.6-terra"

# --- 人間チェックポイント ---
# このループはWORKTREE_DIR上のLOOP_BRANCHでのみコミットする。
# mainへの反映(マージ/PR)はユーザーが手動で行うこと。ループはmainに一切触れない。
